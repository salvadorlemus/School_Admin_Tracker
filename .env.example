# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Only the URL and the publishable key belong here; never the secret / service_role key
# (anything prefixed VITE_ is bundled into the app and visible to every user).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Production only (Render): each part's own address. Leave unset locally (both share one).
# VITE_APP_HOST=lyra.kokoasoft.com
# VITE_ADMIN_HOST=lyra.admin.kokoasoft.com
